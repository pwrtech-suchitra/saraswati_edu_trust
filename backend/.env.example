# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sect_db

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay / Gateway Adapter)
PAYMENT_KEY_ID=rzp_test_your_key_id_here
PAYMENT_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Frontend Integration (Mrinmayee's React App)
FRONTEND_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Trust Compliance Metadata (for 80G Receipts)
TRUST_NAME=Saraswati Educational & Charitable Trust (SECT)
TRUST_REG_NO=TRUST/OD/2018/0091
TRUST_80G_NO=AAETS9821BF20214
