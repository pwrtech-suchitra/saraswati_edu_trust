# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Optional custom CA certificate for production database TLS verification
# DATABASE_SSL_CA=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sect_db
# Optional separate role for applying migrations in managed environments.
# MIGRATION_DATABASE_URL=postgres://sect_migrator:password@localhost:5432/sect_db

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Integration (Mrinmayee's React App)
FRONTEND_URL=http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Trust Compliance Metadata (for 80G Receipts)
TRUST_NAME=Saraswati Educational & Charitable Trust (SECT)
TRUST_REG_NO=
TRUST_80G_NO=
