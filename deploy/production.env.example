PUBLIC_HOSTNAME=sect.example.org
ACME_EMAIL=ops@example.org
FRONTEND_URL=https://sect.example.org
TRUST_PROXY_HOPS=2

# Use separate least-privilege app and DDL-capable migration roles on a managed PostgreSQL service.
# URL-encode special characters in both passwords.
DATABASE_URL=postgresql://sect_app:replace_app_password@db.example.org:5432/sect
MIGRATION_DATABASE_URL=postgresql://sect_migrator:replace_migration_password@db.example.org:5432/sect
# Optional PEM CA certificate for database providers that use a private CA.
# DATABASE_SSL_CA=

# Generate two different random values of at least 32 characters each.
JWT_SECRET=change_me_generate_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_generate_another_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d