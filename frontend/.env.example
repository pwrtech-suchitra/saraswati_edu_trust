# SECT Frontend Environment Variables
# Optional absolute API URL when the frontend and API use different origins.
# Leave unset to use the same-origin /api/v1 path.
# REACT_APP_API_BASE_URL=https://api.example.org/api/v1
# Development proxy target; defaults to http://localhost:5000.
# REACT_APP_API_PROXY_TARGET=http://localhost:5000
